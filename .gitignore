# SOLIDWORKS lock files and backup copies
~$*
*.sldbak
*.SLDBAK
*.bak
*.BAK
*~
Backup of *
AutoRecover/
Backup/

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Local editor state
.idea/
.vscode/
*.tmp
*.log

# Optional Python checker: local environments and bytecode
__pycache__/
*.py[cod]
.venv/
venv/

# Local credentials and environment settings
.env
.env.*
!.env.example

# Native CAD models, exports and project previews are intentionally tracked.
# Do not ignore *.swp: SOLIDWORKS uses that extension for macro files.
